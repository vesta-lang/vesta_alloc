 VestaVM -- Distributed Virtual Machine
 Copyright (C) 2026 David Lopez.T (DesmonHak) (Castilla y Leon, ES)
 License: MIT (see LICENSE).  Part of the VestaVM family.

 A TREE GRID with the information IN the rows, and one panel that follows the
 selection.  Not a chart -- the names do not fit in boxes -- and not a set of
 tabs holding the same numbers side by side: totals you cannot line up with
 what you have selected are a second report that happens to share a page.

 Every string a person reads is marked with `data-t` and comes from the
 catalogue, in whichever language is picked, switched without reloading.  What
 is NOT marked is the measurement: function names, paths, modules and the
 names of the CSV files and their columns are what the export calls things,
 and translating them would make the page and the file disagree.

 The raw export is still here, whole, at the bottom.  Nothing is summarised
 away -- but it is an APPENDIX, which is what it is: the reading happens in
 the tree.
-#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>{{ css }}</style>
</head>
<body>

<header>
  <h1>{{ title }} <span class="sub" id="sub"></span></h1>
  <div id="warns"></div>
  <!-- QUE ESTABA MAL, arriba del todo y no en una tabla del final.  Un hallazgo
       importa mas que cualquier reparto: enterrarlo entre diez tablas crudas es
       tenerlo y no darlo. -->
  <div id="verdicts"></div>

  <div class="tabs">
    <button class="on" data-panel="p-tree" data-t="tab.tree"></button>
    {# El eje del tiempo.  Pestana aparte y no una columna del arbol: el arbol
       contesta QUIEN reserva y esto contesta CUANDO, y sus numeros no se pueden
       sumar entre si.  `time.js` la esconde si la corrida no llevaba eje. #}
    <button data-panel="p-time" data-t="tab.time"></button>
    <button data-panel="p-raw"><span data-t="tab.raw"></span>
      <span class="n">{{ raw_rows }}</span></button>
    <span class="grow"></span>
    {# TRES estados y no dos.  Por defecto manda el sistema, que es lo que casi
       todo el mundo quiere y nadie configura; el interruptor le gana en las dos
       direcciones, porque una pagina que solo ofrece "oscuro" no se puede
       devolver a claro en una maquina puesta en oscuro. #}
    <label class="pick"><span data-t="tool.theme"></span>
      <select id="theme">
        <option value="auto" data-t="theme.auto"></option>
        <option value="light" data-t="theme.light"></option>
        <option value="dark" data-t="theme.dark"></option>
      </select>
    </label>
    <label class="pick"><span data-t="tool.lang"></span>
      <select id="lang">
        {%- for code, name in langs %}
        <option value="{{ code }}">{{ name }}</option>
        {%- endfor %}
      </select>
    </label>
  </div>
</header>

<div class="panel on" id="p-tree">
  <div class="row bar-tools">
    {%- if has_check %}
    {# Only when the run had a checker export.  It goes FIRST because it
       chooses what everything after it is filtering. #}
    <label class="pick"><span data-t="tool.dataset"></span>
      <select id="dataset">
        <option value="alloc" data-t="data.alloc"></option>
        <option value="check" data-t="data.check"></option>
      </select>
    </label>
    {%- endif %}
    <label class="pick"><span data-t="tool.grouping"></span>
      <select id="grouping">
        <option value="stack" data-t="group.stack"></option>
        <option value="module" data-t="group.module"></option>
        <option value="file" data-t="group.file"></option>
        <option value="purpose" data-t="group.purpose"></option>
      </select>
    </label>
    <label class="pick"><span data-t="tool.scope"></span>
      <select id="scope">
        <option value="all" data-t="scope.all"></option>
        <option value="fold" data-t="scope.fold"></option>
        <option value="hide" data-t="scope.hide"></option>
        <option value="extern" data-t="scope.extern"></option>
      </select>
    </label>
    <label class="pick"><span data-t="tool.langfilter"></span>
      <select id="langfilter">
        <option value="all" data-t="lang.all"></option>
        <option value="c" data-t="lang.c"></option>
        <option value="cpp" data-t="lang.cpp"></option>
        <option value="unknown" data-t="lang.unknown"></option>
      </select>
    </label>
    <div class="seg" role="group">
      <button data-dir="td" class="on" data-t="dir.td"></button><button data-dir="bu" data-t="dir.bu"></button>
    </div>
    <input type="search" id="filter" data-tph="ph.filter">
    <label class="chk"><input type="checkbox" id="bybytes">
      <span data-t="chk.bytes"></span></label>
    <button id="expand" data-t="btn.expand"></button>
    <button id="collapse" data-t="btn.collapse"></button>
    <span class="grow"></span>
    <span class="stat" id="stat"></span>
  </div>

  <div class="wrap grid">
  <table id="grid">
    <thead><tr>
      <th data-k="name"><span data-t="col.name"></span></th>
      <th class="n" data-k="total"><span data-t="col.total"></span></th>
      <th class="n" data-k="pct"><span data-t="col.pct"></span></th>
      <th class="n" data-k="self"><span data-t="col.self"></span></th>
      <th class="n" data-k="bytes"><span data-t="col.bytes"></span></th>
      <th class="n" data-k="selfbytes"><span data-t="col.selfbytes"></span></th>
      <th class="n" data-k="large" data-tt="tip.large"><span data-t="col.large"></span></th>
      <th class="n" data-k="classes" data-tt="tip.classes"><span data-t="col.classes"></span></th>
      <th data-k="purpose"><span data-t="col.purpose"></span></th>
      <th class="n" data-k="sites"><span data-t="col.sites"></span></th>
      <th data-k="module"><span data-t="col.module"></span></th>
      <th data-k="file"><span data-t="col.file"></span></th>
      <th class="n" data-k="addr"><span data-t="col.addr"></span></th>
    </tr></thead>
    <tbody id="rows"></tbody>
  </table>
  </div>

  <div id="detail"></div>
</div>

<div class="panel" id="p-time">
  <p class="note" data-t="time.note"></p>
  <div class="row bar-tools">
    {# El GRANO va primero porque decide que son las demas: cambiarlo cambia
       que se puede elegir, no solo como se ve. #}
    <label class="pick"><span data-t="time.group"></span>
      <select id="tgroup">
        <option value="site" data-t="time.g.site"></option>
        <option value="function" data-t="time.g.function"></option>
        <option value="file" data-t="time.g.file"></option>
        <option value="module" data-t="time.g.module"></option>
        {# POR TAMANO y POR FORMA, que no son granos del mismo eje que los de
           arriba: aquellos parten los sitios por DONDE estan, y estos por QUE
           son.  Van en el mismo selector porque la pregunta del lector es la
           misma -- "reparteme la curva por..." -- y tener dos controles para
           eso obliga a entender la diferencia antes de poder mirar. #}
        <option value="size" data-t="time.g.size"></option>
        <option value="shape" data-t="time.g.shape"></option>
        <option value="life" data-t="time.g.life"></option>
      </select>
    </label>
    <label class="pick"><span data-t="time.what"></span>
      <select id="tseries">
        <option value="both" data-t="time.both"></option>
        <option value="live" data-t="time.onlylive"></option>
        <option value="committed" data-t="time.onlycomm"></option>
      </select>
    </label>
    <label class="pick"><span data-t="time.top"></span>
      <select id="ttop">
        <option value="5">5</option>
        <option value="10" selected>10</option>
        <option value="20">20</option>
        <option value="40">40</option>
      </select>
    </label>
    {# LA ESCALA.  Con cuarenta bandas apiladas contra la curva total, las
       finas son una raya: medirlas contra lo ELEGIDO es lo que las separa. #}
    <label class="pick"><span data-t="time.scale"></span>
      <select id="tscale">
        <option value="all" data-t="time.s.all"></option>
        <option value="picked" data-t="time.s.picked"></option>
      </select>
    </label>
    {# COMO SE DIBUJA.  Era una casilla de "apilarlos" con dos respuestas, y
       apilado o no es solo una de las formas de mirar esto: la pila contesta
       cuanto suma, el eje logaritmico deja ver a la vez la banda de 0,5 MiB y
       la de 70, el 100% ensena de QUE esta hecha la memoria, la rejilla da a
       cada banda su propia regla, y las burbujas contestan quien pesa en un
       instante.  Una casilla no puede ofrecer seis respuestas. #}
    <label class="pick"><span data-t="time.draw"></span>
      <select id="tdraw">
        <option value="stack" data-t="time.d.stack"></option>
        <option value="lines" data-t="time.d.lines"></option>
        <option value="log" data-t="time.d.log"></option>
        <option value="pct" data-t="time.d.pct"></option>
        <option value="grid" data-t="time.d.grid"></option>
        <option value="bubbles" data-t="time.d.bubbles"></option>
      </select>
    </label>
    <label class="chk"><input type="checkbox" id="tmine" checked>
      <span data-t="time.hideown"></span></label>
    <span class="grow"></span>
    <span class="stat" data-t="time.help"></span>
  </div>

  {# LA CAJA SE ESTIRA Y EL GRAFICO CRECE CON ELLA.  Con una altura fija, la
     rejilla de veinte bandas o un empaquetado de burbujas se miran por una
     rendija.  `resize: vertical` es del navegador: no hay que programar el
     arrastre, y el lienzo lee su alto de la caja. #}
  <div class="chartbox">
    {# LOS BOTONES DE AMPLIAR, en todos los dibujos y no solo donde hay eje de
       tiempo: en burbujas el arrastre desplaza y sin ampliar no se llega a las
       pequenas. #}
    <div class="zoom">
      <button id="tzout" title="-" data-t="time.z.out"></button>
      <button id="tzin" title="+" data-t="time.z.in"></button>
      <button id="tzall" data-t="time.z.all"></button>
    </div>
    <canvas id="tchart"></canvas>
    <div id="ttip" class="tip"></div>
  </div>
  <div id="tlegend" class="legend"></div>
  {# QUIEN LLAMO A QUIEN.  La cadena entera esta en `check_frames.csv` y hasta
     ahora la pagina solo ensenaba su marco mas interior: el nombre solo dice
     QUE reservo, y la pregunta es casi siempre DESDE DONDE. #}
  <div id="tstack-detail" class="stackbox"></div>

  {# El SELECTOR.  Lo que de verdad hacia falta: el grafico no decide por ti
     que diez series importan -- se marcan y se desmarcan aqui, y el buscador
     filtra la lista, no el grafico. #}
  <div class="row bar-tools">
    <input type="search" id="tfilter" data-tph="time.filter">
    <button id="tall" data-t="time.all"></button>
    <button id="tnone" data-t="time.none"></button>
  </div>
  <div id="tpick" class="picker"></div>

  <h2 class="rawh" id="tpeakhead"></h2>
  <div class="wrap">
  <table class="flat" id="tpeak">
    <thead><tr>
      <th class="n" data-t="time.col.bytes"></th>
      <th class="n" data-t="time.col.share"></th>
      <th data-t="time.col.growth"></th>
      <th data-t="col.name"></th>
      <th data-t="col.file"></th>
    </tr></thead>
    <tbody id="tpeakrows"></tbody>
  </table>
  </div>
</div>

<div class="panel" id="p-raw">
  <p class="note" data-t="raw.note"></p>

  {%- for t in tables %}
  <h2 class="rawh"><code>{{ t.file }}</code> &mdash;
    <span data-t="{{ t.note_key }}"></span></h2>
  <div class="row">
    <input type="search" data-for-table="t-{{ t.id }}" data-for-count="c-{{ t.id }}"
           data-tph="raw.filter" data-tph-what="{{ t.file }}">
    <span class="stat" id="c-{{ t.id }}" data-trows="{{ t.rows|length }}"></span>
  </div>
  <div class="wrap sm">
  <table class="flat" id="t-{{ t.id }}">
    <thead><tr>
      {%- for c in t.columns %}
      <th{% if c.numeric %} class="n"{% endif %}>{{ c.name }}</th>
      {%- endfor %}
    </tr></thead>
    {#- EL CUERPO VA VACIO Y LO LLENA LA PAGINA.  Escrito aqui, cada celda
        costaba sus etiquetas -- una fila de `check_frames.csv` son 441 bytes de
        marcado contra 66 de dato -- y con 185.000 filas eso eran 85 MB de un
        envoltorio repetido.  Las filas viajan en `DATA.raw` y se pintan al
        abrir la pestana, a trozos segun se baja: se ve exactamente lo mismo,
        no falta ni una.  Ver `tables.js`. -#}
    <tbody></tbody>
  </table>
  </div>
  {%- endfor %}
</div>

<script>const DATA = {{ data }};</script>
{% for s in scripts %}
<script>{{ s }}</script>
{% endfor %}
</body>
</html>
